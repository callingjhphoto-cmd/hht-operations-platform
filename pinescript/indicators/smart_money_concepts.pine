// Smart Money Concepts (SMC) — Order Blocks, FVGs, BOS/CHoCH, Liquidity Sweeps
// Based on ICT methodology and LuxAlgo's open-source detection logic

//@version=5
indicator("Smart Money Concepts", shorttitle="SMC", overlay=true, max_boxes_count=100, max_lines_count=100, max_labels_count=50)

// ═══════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════

// Structure Detection
swingLen    = input.int(5, "Swing Detection Length", minval=2, maxval=20, group="Structure", tooltip="Bars left/right to confirm a swing high/low")
showBOS     = input.bool(true, "Show BOS (Break of Structure)", group="Structure")
showCHoCH   = input.bool(true, "Show CHoCH (Change of Character)", group="Structure")

// Fair Value Gaps
showFVG     = input.bool(true, "Show Fair Value Gaps", group="FVG")
fvgFilter   = input.string("Aggressive", "FVG Filter", options=["Aggressive", "Moderate", "Conservative"], group="FVG")
fvgMaxAge   = input.int(50, "FVG Max Age (bars)", minval=10, maxval=200, group="FVG")

// Order Blocks
showOB      = input.bool(true, "Show Order Blocks", group="Order Blocks")
obMaxAge    = input.int(50, "OB Max Age (bars)", minval=10, maxval=200, group="Order Blocks")

// Liquidity
showLiqSweep = input.bool(true, "Show Liquidity Sweeps", group="Liquidity")
liqLookback  = input.int(20, "Liquidity Lookback", minval=5, maxval=100, group="Liquidity")

// Premium/Discount
showPDZones  = input.bool(true, "Show Premium/Discount Zones", group="Zones")
pdLookback   = input.int(50, "P/D Lookback", minval=10, maxval=200, group="Zones")

// Colors
bullColor   = input.color(color.new(#00E676, 70), "Bullish Color", group="Colors")
bearColor   = input.color(color.new(#FF1744, 70), "Bearish Color", group="Colors")
fvgBullClr  = input.color(color.new(#00BCD4, 80), "FVG Bullish", group="Colors")
fvgBearClr  = input.color(color.new(#FF9800, 80), "FVG Bearish", group="Colors")

// ═══════════════════════════════════════════════════
// SWING DETECTION
// ═══════════════════════════════════════════════════

swingHigh = ta.pivothigh(high, swingLen, swingLen)
swingLow  = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
var float prevSwingHigh = na
var float prevSwingLow  = na
var int   lastSHBar     = na
var int   lastSLBar     = na

if not na(swingHigh)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := swingHigh
    lastSHBar     := bar_index - swingLen

if not na(swingLow)
    prevSwingLow := lastSwingLow
    lastSwingLow := swingLow
    lastSLBar    := bar_index - swingLen

// ═══════════════════════════════════════════════════
// MARKET STRUCTURE — BOS & CHoCH
// ═══════════════════════════════════════════════════

var int trend = 0

bosUp   = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh and trend >= 0
bosDn   = not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow and trend <= 0
chochUp = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh and trend < 0
chochDn = not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow and trend > 0

if bosUp or chochUp
    trend := 1
if bosDn or chochDn
    trend := -1

// BOS lines
if showBOS and bosUp
    line.new(bar_index - 1, lastSwingHigh, bar_index, lastSwingHigh,
             color=color.new(#00E676, 30), width=2, style=line.style_solid)
    label.new(bar_index, lastSwingHigh, "BOS▲",
              color=color.new(#00E676, 0), textcolor=color.white,
              style=label.style_label_down, size=size.tiny)

if showBOS and bosDn
    line.new(bar_index - 1, lastSwingLow, bar_index, lastSwingLow,
             color=color.new(#FF1744, 30), width=2, style=line.style_solid)
    label.new(bar_index, lastSwingLow, "BOS▼",
              color=color.new(#FF1744, 0), textcolor=color.white,
              style=label.style_label_up, size=size.tiny)

// CHoCH lines
if showCHoCH and chochUp
    line.new(bar_index - 1, lastSwingHigh, bar_index, lastSwingHigh,
             color=color.new(#FFD600, 30), width=2, style=line.style_dashed)
    label.new(bar_index, lastSwingHigh, "CHoCH▲",
              color=color.new(#FFD600, 0), textcolor=color.black,
              style=label.style_label_down, size=size.tiny)

if showCHoCH and chochDn
    line.new(bar_index - 1, lastSwingLow, bar_index, lastSwingLow,
             color=color.new(#FFD600, 30), width=2, style=line.style_dashed)
    label.new(bar_index, lastSwingLow, "CHoCH▼",
              color=color.new(#FFD600, 0), textcolor=color.black,
              style=label.style_label_up, size=size.tiny)

// ═══════════════════════════════════════════════════
// FAIR VALUE GAPS (FVGs)
// ═══════════════════════════════════════════════════

// Bullish FVG: gap between candle N-2 high and candle N low
bullFVG = low > high[2] and close[1] > high[2]
bearFVG = high < low[2] and close[1] < low[2]

// Size filter
atrVal = ta.atr(14)
fvgMinSize = fvgFilter == "Conservative" ? atrVal * 0.5 :
             fvgFilter == "Moderate" ? atrVal * 0.25 : 0.0

bullFVGFiltered = bullFVG and (low - high[2]) > fvgMinSize
bearFVGFiltered = bearFVG and (low[2] - high) > fvgMinSize

// Track FVG boxes for mitigation
var box[] bullFVGBoxes = array.new_box()
var box[] bearFVGBoxes = array.new_box()

if showFVG and bullFVGFiltered
    b = box.new(bar_index - 2, low, bar_index + fvgMaxAge, high[2],
                bgcolor=fvgBullClr, border_color=color.new(#00BCD4, 50), border_width=1)
    array.push(bullFVGBoxes, b)

if showFVG and bearFVGFiltered
    b = box.new(bar_index - 2, low[2], bar_index + fvgMaxAge, high,
                bgcolor=fvgBearClr, border_color=color.new(#FF9800, 50), border_width=1)
    array.push(bearFVGBoxes, b)

// Mitigate (remove) filled FVGs
if array.size(bullFVGBoxes) > 0
    for i = array.size(bullFVGBoxes) - 1 to 0
        if i < array.size(bullFVGBoxes)
            b = array.get(bullFVGBoxes, i)
            boxTop = box.get_top(b)
            boxRight = box.get_right(b)
            if low <= boxTop or bar_index > boxRight
                box.delete(b)
                array.remove(bullFVGBoxes, i)

if array.size(bearFVGBoxes) > 0
    for i = array.size(bearFVGBoxes) - 1 to 0
        if i < array.size(bearFVGBoxes)
            b = array.get(bearFVGBoxes, i)
            boxBottom = box.get_bottom(b)
            boxRight = box.get_right(b)
            if high >= boxBottom or bar_index > boxRight
                box.delete(b)
                array.remove(bearFVGBoxes, i)

// ═══════════════════════════════════════════════════
// ORDER BLOCKS
// ═══════════════════════════════════════════════════

// Bullish OB: last bearish candle before a displacement move up
// Bearish OB: last bullish candle before a displacement move down

displacement = math.abs(close - open) > atrVal * 1.5

bullOB = displacement and close > open and close[1] < open[1]
bearOB = displacement and close < open and close[1] > open[1]

var box[] bullOBBoxes = array.new_box()
var box[] bearOBBoxes = array.new_box()

if showOB and bullOB
    b = box.new(bar_index - 1, high[1], bar_index + obMaxAge, low[1],
                bgcolor=bullColor, border_color=color.new(#00E676, 40), border_width=2)
    array.push(bullOBBoxes, b)

if showOB and bearOB
    b = box.new(bar_index - 1, high[1], bar_index + obMaxAge, low[1],
                bgcolor=bearColor, border_color=color.new(#FF1744, 40), border_width=2)
    array.push(bearOBBoxes, b)

// Mitigate filled Order Blocks
if array.size(bullOBBoxes) > 0
    for i = array.size(bullOBBoxes) - 1 to 0
        if i < array.size(bullOBBoxes)
            b = array.get(bullOBBoxes, i)
            boxBottom = box.get_bottom(b)
            boxRight = box.get_right(b)
            if close < boxBottom or bar_index > boxRight
                box.delete(b)
                array.remove(bullOBBoxes, i)

if array.size(bearOBBoxes) > 0
    for i = array.size(bearOBBoxes) - 1 to 0
        if i < array.size(bearOBBoxes)
            b = array.get(bearOBBoxes, i)
            boxTop = box.get_top(b)
            boxRight = box.get_right(b)
            if close > boxTop or bar_index > boxRight
                box.delete(b)
                array.remove(bearOBBoxes, i)

// ═══════════════════════════════════════════════════
// LIQUIDITY SWEEPS
// ═══════════════════════════════════════════════════

recentHigh = ta.highest(high, liqLookback)
recentLow  = ta.lowest(low, liqLookback)

// Sweep above recent high then close back below
bullSweep = high > recentHigh[1] and close < recentHigh[1] and close < open
bearSweep = low < recentLow[1] and close > recentLow[1] and close > open

if showLiqSweep
    if bullSweep
        label.new(bar_index, high, "LIQ▼",
                  color=color.new(#FFD600, 0), textcolor=color.black,
                  style=label.style_label_down, size=size.tiny)

    if bearSweep
        label.new(bar_index, low, "LIQ▲",
                  color=color.new(#FFD600, 0), textcolor=color.black,
                  style=label.style_label_up, size=size.tiny)

// ═══════════════════════════════════════════════════
// PREMIUM / DISCOUNT ZONES
// ═══════════════════════════════════════════════════

pdHigh = ta.highest(high, pdLookback)
pdLow  = ta.lowest(low, pdLookback)
pdMid  = (pdHigh + pdLow) / 2.0

// 50% equilibrium line
plot(showPDZones ? pdMid : na, "Equilibrium", color.new(#FFFFFF, 60), linewidth=1, style=plot.style_stepline)

// Background shading for premium/discount
isPremium  = close > pdMid + (pdHigh - pdMid) * 0.5
isDiscount = close < pdMid - (pdMid - pdLow) * 0.5
bgcolor(showPDZones and isPremium ? color.new(#FF1744, 95) : showPDZones and isDiscount ? color.new(#00E676, 95) : na)

// ═══════════════════════════════════════════════════
// TREND BAR COLORING
// ═══════════════════════════════════════════════════

barcolor(trend == 1 ? color.new(#00E676, 30) : trend == -1 ? color.new(#FF1744, 30) : na)

// ═══════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════

if barstate.islast
    var table smcTable = table.new(position.top_right, 2, 5, border_width=1)

    trendText = trend == 1 ? "BULLISH" : trend == -1 ? "BEARISH" : "NEUTRAL"
    trendClr  = trend == 1 ? color.lime : trend == -1 ? color.red : color.gray

    table.cell(smcTable, 0, 0, "SMC", text_color=color.white, bgcolor=color.new(#263238, 0), text_size=size.small)
    table.cell(smcTable, 1, 0, trendText, text_color=trendClr, bgcolor=color.new(#263238, 0), text_size=size.small)

    table.cell(smcTable, 0, 1, "Swing H", text_color=color.white, bgcolor=color.new(#37474F, 0), text_size=size.tiny)
    table.cell(smcTable, 1, 1, not na(lastSwingHigh) ? str.tostring(lastSwingHigh, format.mintick) : "—", text_color=color.white, bgcolor=color.new(#37474F, 0), text_size=size.tiny)

    table.cell(smcTable, 0, 2, "Swing L", text_color=color.white, bgcolor=color.new(#37474F, 0), text_size=size.tiny)
    table.cell(smcTable, 1, 2, not na(lastSwingLow) ? str.tostring(lastSwingLow, format.mintick) : "—", text_color=color.white, bgcolor=color.new(#37474F, 0), text_size=size.tiny)

    table.cell(smcTable, 0, 3, "Zone", text_color=color.white, bgcolor=color.new(#37474F, 0), text_size=size.tiny)
    zoneText = isPremium ? "PREMIUM" : isDiscount ? "DISCOUNT" : "EQUILIBRIUM"
    zoneClr  = isPremium ? color.red : isDiscount ? color.lime : color.orange
    table.cell(smcTable, 1, 3, zoneText, text_color=zoneClr, bgcolor=color.new(#37474F, 0), text_size=size.tiny)

    table.cell(smcTable, 0, 4, "FVGs", text_color=color.white, bgcolor=color.new(#37474F, 0), text_size=size.tiny)
    table.cell(smcTable, 1, 4, "B:" + str.tostring(array.size(bullFVGBoxes)) + " S:" + str.tostring(array.size(bearFVGBoxes)), text_color=color.white, bgcolor=color.new(#37474F, 0), text_size=size.tiny)

// ═══════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════

alertcondition(bosUp, "Bullish BOS", "Break of Structure to the upside — bullish continuation")
alertcondition(bosDn, "Bearish BOS", "Break of Structure to the downside — bearish continuation")
alertcondition(chochUp, "Bullish CHoCH", "Change of Character to bullish — potential trend reversal")
alertcondition(chochDn, "Bearish CHoCH", "Change of Character to bearish — potential trend reversal")
alertcondition(bullFVGFiltered, "Bullish FVG", "Bullish Fair Value Gap formed — potential support zone")
alertcondition(bearFVGFiltered, "Bearish FVG", "Bearish Fair Value Gap formed — potential resistance zone")
alertcondition(bullOB, "Bullish Order Block", "Bullish Order Block formed — institutional demand zone")
alertcondition(bearOB, "Bearish Order Block", "Bearish Order Block formed — institutional supply zone")
alertcondition(bullSweep, "Bearish Liquidity Sweep", "Liquidity swept above highs — potential reversal down")
alertcondition(bearSweep, "Bullish Liquidity Sweep", "Liquidity swept below lows — potential reversal up")
